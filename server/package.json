{
  "name": "@hemored/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --disable-warning=ExperimentalWarning src/index.ts",
    "start": "node --env-file-if-exists=../.env --disable-warning=ExperimentalWarning src/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.ts --reset",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "mupdf": "^1.26.4",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.3"
  }
}
