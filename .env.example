# Copiá este archivo como .env (no se versiona) y completá solo lo que vayas a usar.

# --- Correo saliente (confirmación, recordatorio y cancelación de turnos; convocatorias) ---
# Sin SMTP_HOST, cada correo se guarda como .eml en server/data/correos/.
# Con una cuenta de Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=la cuenta completa, SMTP_PASS=una contraseña de aplicación de Google (no la
# contraseña de la cuenta) y CORREO_REMITENTE="HemoRed <la-misma-cuenta@gmail.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE="HemoRed <no-responder@tu-dominio>"


# --- Otros ---
# PUBLIC_URL=http://localhost:5173
# API_PORT=3001
